{
  "name": "cue",
  "productName": "Cue",
  "version": "0.1.0",
  "description": "Interview and assessment companion",
  "main": "desktop/main.cjs",
  "private": true,
  "license": "MIT",
  "author": "Cue contributors",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.cjs",
    "web": "node server.cjs",
    "test": "node --test test/*.test.cjs",
    "build:mac": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "electron": "44.5.1", "electron-builder": "26.15.3" },
  "build": {
    "appId": "dev.cue.app",
    "productName": "Cue",
    "files": ["desktop/**", "core/**", "ui/**", "assets/**", "licenses/**", "LICENSE", "THIRD_PARTY.md", "package.json"],
    "directories": { "output": "dist" },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record a question for transcription when you press Record.",
        "NSScreenCaptureUsageDescription": "Attach a screen or window that you select to a question."
      }
    },
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "linux": { "target": "AppImage", "category": "Office", "icon": "assets/icon.png" }
  }
}
